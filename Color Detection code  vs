import cv2
import numpy as np


camera = cv2.VideoCapture(0)


cv2.namedWindow("Color Detection", cv2.WINDOW_NORMAL)
cv2.resizeWindow("Color Detection", 700, 500)

while True:

  
    ret, frame = camera.read()

    if not ret:
        break


    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)

    blue_low = np.array([90, 100, 50])
    blue_high = np.array([130, 255, 255])

    blue_mask = cv2.inRange(
        hsv,
        blue_low,
        blue_high
    )

    green_low = np.array([35, 80, 50])
    green_high = np.array([85, 255, 255])

    green_mask = cv2.inRange(
        hsv,
        green_low,
        green_high
    )


    yellow_low = np.array([20, 100, 50])
    yellow_high = np.array([35, 255, 255])

    yellow_mask = cv2.inRange(
        hsv,
        yellow_low,
        yellow_high
    )


    red_low1 = np.array([0, 180, 80])
    red_high1 = np.array([7, 255, 255])

    red_low2 = np.array([173, 180, 80])
    red_high2 = np.array([180, 255, 255])

    red_mask1 = cv2.inRange(
        hsv,
        red_low1,
        red_high1
    )

    red_mask2 = cv2.inRange(
        hsv,
        red_low2,
        red_high2
    )

    red_mask = red_mask1 + red_mask2


    colors = [
        (blue_mask, "Blue"),
        (green_mask, "Green"),
        (yellow_mask, "Yellow"),
        (red_mask, "Red")
    ]


    for mask, color_name in colors:

        contours, _ = cv2.findContours(
            mask,
            cv2.RETR_EXTERNAL,
            cv2.CHAIN_APPROX_SIMPLE
        )

        for contour in contours:

           
           
            area = cv2.contourArea(contour)

        
            if area > 1500:

               
                x, y, w, h = cv2.boundingRect(contour)


                cv2.rectangle(
                    frame,
                    (x, y),
                    (x + w, y + h),
                    (255, 255, 255),
                    2
                )

                cv2.putText(
                    frame,
                    color_name,
                    (x, y - 10),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.8,
                    (255, 255, 255),
                    2
                )

    cv2.imshow("Color Detection", frame)

    if cv2.waitKey(1) & 0xFF == ord("q"):
        break

camera.release()
cv2.destroyAllWindows()
